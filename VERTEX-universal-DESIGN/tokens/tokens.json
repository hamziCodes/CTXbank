{
  "$comment": "VERTEX Universal Design tokens. Platform-neutral source for non-CSS targets: native shells, Figma plugins, e-mail, slides, PDF. Never hand-transcribe values from the docs; read this file. If it disagrees with tokens.css, tokens.css wins.",
  "version": "1.0.0",
  "brand": "VERTEX",
  "accentPolicy": "One accent family only. --brand-primary is a FILL token. Accent text and focus rings use accentText, because brandPrimary on the dark canvas measures 2.2:1 and fails WCAG.",

  "color": {
    "navy": {
      "50": "#eff6fb",
      "100": "#dbebf5",
      "200": "#bad6e8",
      "300": "#90bbd5",
      "400": "#609abe",
      "500": "#236798",
      "600": "#1a537c",
      "700": "#0b3b5b",
      "800": "#042940",
      "900": "#021c2c",
      "950": "#01111b"
    },

    "light": {
      "brandPrimary": "#042940",
      "brandHover": "#0b3b5b",
      "cta": "#042940",
      "ctaHover": "#0b3b5b",
      "ctaForeground": "#ffffff",
      "accentText": "#042940",
      "accentTextHover": "#0b3b5b",
      "focusRing": "#042940",

      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "muted": "#000000",
      "border": "rgba(0, 0, 0, 0.08)",
      "buttonSecondary": "#000000",
      "surfaceDark": "#000000",
      "surfaceHover": "rgba(0, 0, 0, 0.04)",

      "appCanvas": "#f2f6f9",
      "appSurface": "#ffffff",
      "appSurfaceSunken": "#e7eef4",
      "appSurfaceInverse": "#042940",
      "appSurfaceHover": "rgba(4, 41, 64, 0.04)",
      "appOnInverse": "#ffffff",
      "appLine": "#dbe4ec",
      "appLineStrong": "#c2d0dd",
      "appLineInverse": "rgba(255, 255, 255, 0.18)",
      "appInk": "#000000",
      "appInkSoft": "rgba(0, 0, 0, 0.64)",
      "appInkMuted": "rgba(0, 0, 0, 0.52)",

      "positive": "#0f6b4f",
      "positiveSoft": "#e2f2ec",
      "positiveLine": "#bfdfd2",
      "negative": "#b02a25",
      "negativeSoft": "#fbe9e7",
      "negativeLine": "#f0cdc8",
      "attention": "#8a5b00",
      "attentionSoft": "#fdf1dc",
      "attentionLine": "#eed9b0",
      "info": "#042940",
      "infoSoft": "#eff6fb",
      "infoLine": "#cbdeeb",

      "shadowColor": "#dce5ec",
      "shadowColorStrong": "#b9c8d5",
      "scrim": "rgba(4, 41, 64, 0.38)"
    },

    "dark": {
      "brandPrimary": "#1a537c",
      "brandHover": "#236798",
      "cta": "#1a537c",
      "ctaHover": "#236798",
      "ctaForeground": "#ffffff",
      "accentText": "#609abe",
      "accentTextHover": "#90bbd5",
      "focusRing": "#609abe",

      "background": "#161719",
      "foreground": "#f3f4f6",
      "card": "#212326",
      "muted": "#9ca3af",
      "border": "#2e3238",
      "buttonSecondary": "#2d3035",
      "surfaceDark": "#212326",
      "surfaceHover": "#2d3035",

      "appCanvas": "#161719",
      "appSurface": "#212326",
      "appSurfaceSunken": "#101113",
      "appSurfaceInverse": "#f3f4f6",
      "appSurfaceHover": "#2d3035",
      "appOnInverse": "#161719",
      "appLine": "#2e3238",
      "appLineStrong": "#3d434b",
      "appLineInverse": "rgba(22, 23, 25, 0.18)",
      "appInk": "#f3f4f6",
      "appInkSoft": "rgba(243, 244, 246, 0.72)",
      "appInkMuted": "#9ca3af",

      "positive": "#3fae86",
      "positiveSoft": "rgba(63, 174, 134, 0.16)",
      "positiveLine": "rgba(63, 174, 134, 0.34)",
      "negative": "#f0766a",
      "negativeSoft": "rgba(240, 118, 106, 0.16)",
      "negativeLine": "rgba(240, 118, 106, 0.34)",
      "attention": "#e0a94a",
      "attentionSoft": "rgba(224, 169, 74, 0.16)",
      "attentionLine": "rgba(224, 169, 74, 0.34)",
      "info": "#609abe",
      "infoSoft": "rgba(96, 154, 190, 0.16)",
      "infoLine": "rgba(96, 154, 190, 0.34)",

      "shadowColor": "#0d0e10",
      "shadowColorStrong": "#08090a",
      "scrim": "rgba(0, 0, 0, 0.58)"
    },

    "footer": {
      "$comment": "Charcoal in both modes. Does not flip with the page canvas.",
      "bg": "#161719",
      "elevated": "#212326",
      "foreground": "#f3f4f6",
      "muted": "#9ca3af",
      "border": "#2e3238"
    },

    "chartSeries": {
      "$comment": "Fixed order so the same data reads the same way in every product.",
      "light": ["#042940", "#236798", "#90bbd5", "#1a537c", "#bad6e8"],
      "dark": ["#90bbd5", "#609abe", "#236798", "#bad6e8", "#1a537c"]
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "Inter Tight",
      "sansFallback": "Inter, system-ui, -apple-system, Segoe UI, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace",
      "monoPolicy": "Code, logs, IDs and diffs only. Never UI chrome."
    },
    "weight": {
      "display": 900,
      "bold": 700,
      "body": 500,
      "light": 300
    },
    "size": {
      "display": "clamp(4.25rem, 18vw, 17.525rem)",
      "hero": "clamp(3rem, 5.56vw, 5rem)",
      "title": "clamp(2rem, 3.61vw, 3.25rem)",
      "lead": "clamp(1.125rem, 1.67vw, 1.5rem)",
      "menu": "3rem",
      "metricXl": "40px",
      "metric": "30px",
      "metricSm": "22px",
      "heading": "22px",
      "subheading": "18px",
      "body": "15px",
      "bodySm": "14px",
      "label": "13px",
      "eyebrow": "11px",
      "nav": "10px"
    },
    "measure": {
      "body": "46ch",
      "prose": "720px"
    }
  },

  "shape": {
    "radius": {
      "control": "12px",
      "slab": "18px",
      "panel": "24px",
      "sheet": "28px",
      "pill": "9999px",
      "marketing": "clamp(40px, 4.167vw, 60px)",
      "marketingPolicy": "Marketing archetype only. Application surfaces never exceed 28px."
    },
    "borderWidth": {
      "hairline": "1px",
      "slab": "1.5px",
      "emphasis": "2px"
    }
  },

  "elevation": {
    "$comment": "Hard, zero-blur offsets. The sheet lift is the only blurred shadow in the system. Brand-filled slabs carry no shadow.",
    "light": {
      "slab": "3px 4px 0 #dce5ec",
      "slabStrong": "3px 4px 0 #b9c8d5",
      "slabPressed": "1px 2px 0 #b9c8d5",
      "sheet": "0 -5px 20px rgba(4, 41, 64, 0.12)"
    },
    "dark": {
      "slab": "3px 4px 0 #0d0e10",
      "slabStrong": "3px 4px 0 #08090a",
      "slabPressed": "1px 2px 0 #08090a",
      "sheet": "0 -5px 20px rgba(0, 0, 0, 0.45)"
    }
  },

  "density": {
    "$comment": "compact and dense are pointer-precise. On a coarse pointer, controlHeight clamps to 44 and rowPadY to 12.",
    "touchFloor": 44,
    "comfortable": {
      "controlHeight": 48,
      "controlPadX": 20,
      "controlGap": 8,
      "slabPad": 24,
      "stackGap": 18,
      "rowPadY": 12,
      "rowGap": 12,
      "fieldGap": 20,
      "iconTile": 36,
      "textBody": 15
    },
    "compact": {
      "controlHeight": 40,
      "controlPadX": 16,
      "controlGap": 6,
      "slabPad": 18,
      "stackGap": 14,
      "rowPadY": 10,
      "rowGap": 8,
      "fieldGap": 16,
      "iconTile": 32,
      "textBody": 14
    },
    "dense": {
      "controlHeight": 34,
      "controlPadX": 12,
      "controlGap": 4,
      "slabPad": 14,
      "stackGap": 10,
      "rowPadY": 7,
      "rowGap": 4,
      "fieldGap": 12,
      "iconTile": 28,
      "textBody": 13
    }
  },

  "layout": {
    "pageMax": "1440px",
    "appMax": "740px",
    "proseMax": "720px",
    "navHeight": "72px",
    "bottomNavHeight": "70px",
    "sidebarWidth": "264px",
    "sidebarWidthCollapsed": "72px",
    "desktopBottomNavWidth": "600px",
    "pagePad": { "base": "24px", "md": "32px", "lg": "clamp(24px, 2.778vw, 40px)" }
  },

  "motion": {
    "$comment": "One curve for the entire system. Never mix easing curves.",
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeArray": [0.16, 1, 0.3, 1],
    "durationMs": {
      "micro": 200,
      "swap": 320,
      "panel": 450,
      "reveal": 800,
      "hero": 950
    },
    "revealTravelPx": { "min": 16, "default": 24, "hero": 28, "form": 32 },
    "budget": {
      "full": ["reveals", "scrollLinkedTransforms", "layoutAnimations", "loops"],
      "reduced": ["reveals", "layoutAnimations"],
      "minimal": []
    }
  },

  "money": {
    "defaultCurrency": "PKR",
    "defaultLocale": "en-PK",
    "format": "PKR 184,250",
    "signIn": "+ PKR 82,000",
    "signOut": "- PKR 46,780",
    "rules": [
      "Always tabular-nums so columns align and a changing value does not reflow its row.",
      "Pass a positive magnitude and express direction through the sign, so colour and prefix can never disagree.",
      "Route every figure through one formatMoney() helper. No inline number formatting in components.",
      "Whole units in lists and metrics. Two decimals only in reconciliation and invoice lines, consistent down the whole column."
    ]
  },

  "contrast": {
    "$comment": "Measured WCAG 2.1 ratios. Below 4.5 is decorative only.",
    "light": {
      "#000000 on #ffffff": 21.0,
      "#042940 on #ffffff": 15.0,
      "#ffffff on #042940": 15.0,
      "#0f6b4f on #ffffff": 6.5,
      "#0f6b4f on #e2f2ec": 5.6,
      "#b02a25 on #ffffff": 6.6,
      "#8a5b00 on #ffffff": 5.9,
      "#609abe on #ffffff": 3.1
    },
    "dark": {
      "#f3f4f6 on #161719": 15.4,
      "#609abe on #161719": 5.8,
      "#90bbd5 on #161719": 8.8,
      "#3fae86 on #161719": 6.5,
      "#f0766a on #161719": 6.4,
      "#e0a94a on #161719": 8.5,
      "#1a537c on #161719": 2.2
    },
    "failures": [
      "#1a537c on #161719 is 2.2:1. brandPrimary is a fill token in dark mode and must never be text there. Use accentText (#609abe).",
      "#609abe on #ffffff is 3.1:1. Decorative only on a light canvas."
    ]
  },

  "banned": {
    "color": [
      "a second accent of any kind",
      "cobalt #2B5EF5",
      "orange",
      "purple",
      "gradients"
    ],
    "material": [
      "glassmorphism as a card material",
      "blurred drop shadows other than the sheet lift",
      "coloured glows",
      "text-shadow on body copy"
    ],
    "imagery": [
      "3D blobs",
      "robot avatars",
      "sparkle icons",
      "gradient duotone icons"
    ],
    "chrome": [
      "pill badges as decoration",
      "generic 3-up bordered card grids",
      "template SaaS admin shells",
      "pure black canvases"
    ],
    "copy": [
      "leverage",
      "synergy",
      "seamless",
      "revolutionize",
      "cutting-edge",
      "state-of-the-art",
      "game-changing",
      "next-gen",
      "world-class"
    ],
    "content": [
      "invented reviews",
      "invented client logos",
      "invented SLAs or metrics",
      "invented legal entities or addresses"
    ]
  }
}
